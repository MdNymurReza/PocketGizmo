NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- New-order alerts on Telegram (optional) ---
# 1. In Telegram, message @BotFather, send /newbot and copy the token.
# 2. Send any message to your new bot, then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates and copy "chat":{"id": ...}.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Spam protection with Cloudflare Turnstile (optional, recommended in production) ---
# Create a widget at https://dash.cloudflare.com -> Turnstile, add your domain (and localhost).
# Leave both empty to switch the check off.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- SMS order updates with BulkSMSBD (optional) ---
# bulksmsbd.net -> API key, plus an approved sender ID (or the default one they give you).
# BulkSMSBD only accepts calls from whitelisted IPs: Vercel has no fixed IP, so ask
# BulkSMSBD support to switch the IP check off for your API key (error 1032 = IP not whitelisted).
BULKSMSBD_API_KEY=
BULKSMSBD_SENDER_ID=

# --- Steadfast Courier booking (optional) ---
# Steadfast merchant panel -> API -> Api-Key and Secret-Key.
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
